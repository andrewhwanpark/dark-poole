---
import { Picture, getImage } from 'astro:assets';
import Aerolith from '../layouts/Aerolith.astro';
import redline from '../../aerolith-galery/Lithframe_Bezier_01_Redline_4K.png';
import obsidian from '../../aerolith-galery/Lithframe_Bezier_02_Obsidian_4K.png';
import powertrain from '../../aerolith-galery/Lithframe_Bezier_03_Powertrain_4K.png';
import exploded from '../../aerolith-galery/Lithframe_Bezier_04_Exploded_4K.png';
import service from '../../aerolith-galery/Lithframe_Bezier_05_Service_4K.png';
import silhouette from '../../aerolith-galery/Lithframe_Bezier_06_Silhouette_4K.png';
import flightController from '../../aerolith-galery/Lithframe_Bezier_07_FC_4K.png';
import windings from '../../aerolith-galery/Lithframe_Bezier_08_Windings_4K.png';
import harness from '../../aerolith-galery/Lithframe_Bezier_09_Harness_4K.png';
import lithcore from '../../public/data/aerolith/lithcore.json';
import lithdrive from '../../public/data/aerolith/lithdrive.json';

// Textures du hero : paysage pour les écrans larges, vue éclatée verticale pour le mobile.
const heroWide = await getImage({ src: redline, width: 1920, format: 'webp', quality: 72 });
const heroTall = await getImage({ src: exploded, width: 1400, format: 'webp', quality: 72 });

// Chaque planche a une petite version pour générer son ASCII.
const plate = async (image: ImageMetadata, title: string, n: string, span = '') => ({
  image,
  title,
  n,
  span,
  ascii: (await getImage({ src: image, width: 320, format: 'webp', quality: 60 })).src,
});
const fcPlate = await plate(flightController, 'LithCore Rev A, populated', 'Fig. 03');
const explodedPlate = await plate(exploded, 'Exploded assembly', 'Fig. 02');
const windingsPlate = await plate(windings, 'Stator, 12 slots', 'Fig. 04');
const plates = await Promise.all([
  plate(silhouette, 'Silhouette', 'Pl. 01', 'a'),
  plate(powertrain, 'Powertrain', 'Pl. 02', 'b'),
  plate(service, 'Service access', 'Pl. 03', 'c'),
  plate(harness, 'Harness routing', 'Pl. 04', 'd'),
  plate(obsidian, 'Obsidian', 'Pl. 05', 'e'),
]);

const fc = lithcore.stats;
const esc = lithdrive.stats;

const mark =
  'M-6.95 6.1L-.66-6.03Q-.45-6.4-.24-6.06L6.71 3.07Q6.8 3.4 6.49 3.47L-.48 2.74-6.6 6.43Q-7.05 6.5-6.95 6.1Z';

const status = [
  { group: 'Power', name: 'LithDrive 3S', note: 'Validated on Nanolith', s: [2, 2, 2, 2] },
  { group: '', name: 'LithDrive 6S', note: 'Rev A fabricated, awaiting parts', s: [2, 2, 0, 0] },
  { group: 'Avionics', name: 'LithCore Rev A', note: 'USB, SWD, OSD, flash up', s: [2, 2, 2, 1] },
  { group: '', name: 'LithCore Rev B', note: 'Errata closed, AIO study', s: [1, 0, 0, 0] },
  { group: 'Airframe', name: 'Lithframe V1', note: 'Acrylic, 330 mm', s: [2, 2, 2, 0] },
  { group: '', name: 'Lithframe F380', note: 'Carbon cut files ready', s: [2, 1, 0, 0] },
  { group: 'Firmware', name: 'Drivers', note: 'C, FreeRTOS', s: [2, 1, 0, 0] },
  { group: '', name: 'ELRS link', note: 'Library in progress', s: [2, 1, 0, 0] },
  { group: '', name: 'Attitude control', note: 'Not started', s: [0, 0, 0, 0] },
];
const stages = ['Design', 'Build', 'Bring-up', 'Validated'];
const glyph = ['·', '■', '■'];
---

<Aerolith
  title="Aerolith — Heavy-lift cinema quadcopter"
  description="Aerolith: a heavy-lift cinema quadcopter. Carbon airframe, flight controller, motor drives and firmware designed from scratch."
>
  <header class="bar">
    <a class="bar-mark" href="#top" aria-label="Aerolith, back to top">
      <svg viewBox="-7.5 -7 15 14" aria-hidden="true"><path d={mark} /></svg>
      <span>Aerolith</span>
    </a>
    <nav class="bar-nav" aria-label="Sections">
      <a href="#frame" data-nav="frame"><i>01</i>Frame</a>
      <a href="#lithcore" data-nav="lithcore"><i>02</i>LithCore</a>
      <a href="#lithdrive" data-nav="lithdrive"><i>03</i>LithDrive</a>
      <a href="#status" data-nav="status"><i>04</i>Status</a>
    </nav>
    <span class="bar-now" aria-hidden="true"></span>
    <a class="bar-out" href="/archive">Logs <span aria-hidden="true">↗</span></a>
    <span class="bar-progress" aria-hidden="true"></span>
  </header>

  <main id="top">
    <!-- 00 — Hero -->
    <section class="hero" data-wide={heroWide.src} data-tall={heroTall.src} aria-label="Aerolith">
      <Picture
        class="hero-fallback"
        src={redline}
        alt="Aerolith on the ground, lit by a red light strip"
        widths={[960, 1600, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={55}
        loading="eager"
        fetchpriority="high"
      />
      <canvas class="hero-ascii" aria-hidden="true"></canvas>
      <div class="hero-ui">
        <p class="hero-fig mono">Fig. 01 — Lithframe F380, render</p>
        <h1 class="wordmark"><span data-decode>AEROLITH</span></h1>
        <dl class="hero-meta mono">
          <div><dt>Type</dt><dd>Heavy-lift cinema quadcopter</dd></div>
          <div><dt>Payload</dt><dd>Full-frame, A7S III class</dd></div>
          <div><dt>Power</dt><dd>6S, 380 mm carbon frame</dd></div>
          <div><dt>Stage</dt><dd><b class="pulse"></b>In development</dd></div>
        </dl>
      </div>
    </section>

    <!-- Manifeste -->
    <section class="thesis">
      <p class="thesis-line">
        An aerial camera platform designed <em>from the copper up</em>: airframe, flight controller, motor drives and
        firmware.
      </p>
      <div class="thesis-aside mono">
        <p>No off-the-shelf flight stack.</p>
        <p>Designed, assembled and brought up by two engineers at the INSA Fablab.</p>
      </div>
      <ol class="stack mono" aria-label="System layers">
        <li><a href="#frame"><i>01</i><span>Airframe</span><em>Lithframe F380</em></a></li>
        <li><a href="#lithcore"><i>02</i><span>Flight controller</span><em>LithCore</em></a></li>
        <li><a href="#lithdrive"><i>03</i><span>Motor drive</span><em>LithDrive 6S</em></a></li>
        <li><a href="#status"><i>04</i><span>Firmware</span><em>C / FreeRTOS</em></a></li>
      </ol>
    </section>

    <!-- 01 — Châssis -->
    <section id="frame" class="chapter" data-section="frame">
      <header class="chapter-head">
        <span class="chapter-n mono">01</span>
        <h2><span class="chapter-kicker mono">Airframe</span>Lithframe F380</h2>
        <p class="chapter-lede">
          Laser-cut carbon. Two plates and four arms that slot into integrated interfaces, held by standoffs. Every part
          comes off a single nested sheet.
        </p>
      </header>

      <div class="cutsheet" data-src="/data/aerolith/cutsheet.json">
        <div class="cut-sticky">
          <div class="cut-head mono">
            <span>Nesting — 1000 × 600 mm sheet</span>
            <span class="cut-hint">Scroll to cut</span>
          </div>
          <div class="cut-stage">
            <canvas aria-hidden="true"></canvas>
            <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
          </div>
          <div class="cut-read mono" aria-hidden="true">
            <div><span>Cut</span><b><output data-out="len">0.00</output> / 55.14 m</b></div>
            <div><span>Part</span><b><output data-out="part">00</output> / 72</b></div>
            <div><span>Head</span><b>X <output data-out="x">0000.0</output> Y <output data-out="y">000.0</output></b></div>
            <div class="cut-bar"><i data-out="bar"></i></div>
          </div>
          <p class="sr-only">Cut path of the 72 carbon parts nested on one sheet, 55 metres of laser cut in total.</p>
        </div>
      </div>

      <div class="frame-detail">
        <table class="parts mono">
          <caption>Parts, from the cut files</caption>
          <thead><tr><th>Part</th><th>Envelope</th><th>Qty / frame</th></tr></thead>
          <tbody>
            <tr><td>Base plate</td><td>270 × 126 mm</td><td>2</td></tr>
            <tr><td>Long arm</td><td>190 × 28 mm</td><td>2</td></tr>
            <tr><td>Short arm</td><td>160 × 28 mm</td><td>2</td></tr>
            <tr><td>Motor mount</td><td>61 × 47 mm</td><td>4</td></tr>
          </tbody>
        </table>
        <p class="note">
          V1 was cut in acrylic at 330 mm to iterate fast. Motor spacing was opened up to keep rotor wash apart before
          the first carbon cut.
        </p>
        <figure class="plate plate-exploded" data-ascii={explodedPlate.ascii}>
          <Picture src={exploded} alt="Exploded view of the Aerolith assembly" widths={[640, 960, 1400]} sizes="(min-width: 900px) 58vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
          <canvas aria-hidden="true"></canvas>
          <figcaption class="mono"><span>{explodedPlate.n}</span>{explodedPlate.title}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 — Contrôleur de vol -->
    <section id="lithcore" class="chapter" data-section="lithcore">
      <header class="chapter-head">
        <span class="chapter-n mono">02</span>
        <h2><span class="chapter-kicker mono">Flight controller</span>LithCore</h2>
        <p class="chapter-lede">
          STM32F405, four layers, 38 millimetres square. Every trace below comes from the production layout.
        </p>
      </header>

      <div class="board board-square" data-svg="/data/aerolith/lithcore.svg" data-meta="/data/aerolith/lithcore.json" data-cycle="SPI1_SCK,USBD+,SWDIO,UART2_RX_RC_RX,5V_BUCK,S1,I2C_SDA,AT7456E_VIDEO_OUT">
        <div class="board-view">
          <div class="board-tools mono">
            <div class="layers" role="group" aria-label="Copper layer">
              <button data-view="all" aria-pressed="true">All</button>
              <button data-view="top" aria-pressed="false">Top</button>
              <button data-view="in1" aria-pressed="false">In1</button>
              <button data-view="in2" aria-pressed="false">In2</button>
              <button data-view="bot" aria-pressed="false">Bot</button>
            </div>
            <div class="readout" aria-live="polite"><span>Net</span><b data-out="net">—</b><em data-out="info"></em></div>
          </div>
          <div class="pcb-stage"><canvas aria-label="LithCore copper layout rendered as text, hover to trace a net"></canvas></div>
          <p class="board-dim mono"><span>{fc.w} × {fc.h} mm</span><span>4 layers</span><span>{fc.components} parts</span><span>{fc.vias} vias</span></p>
        </div>
        <dl class="spec mono">
          <div><dt>MCU</dt><dd>STM32F405RGT6<small>Cortex-M4F, 168 MHz</small></dd></div>
          <div><dt>IMU</dt><dd>ICM-42688-P<small>SPI1, dedicated chip select</small></dd></div>
          <div><dt>Baro</dt><dd>LPS22HH</dd></div>
          <div><dt>OSD</dt><dd>AT7456E<small>Analog video in / out</small></dd></div>
          <div><dt>Log</dt><dd>W25Q128JV<small>128 Mbit blackbox flash</small></dd></div>
          <div><dt>Power</dt><dd>LMR51430 buck, TPS7A20 LDO<small>USB / battery OR-ing</small></dd></div>
          <div><dt>I/O</dt><dd>USB-C, 5 UART, I²C, SWD<small>8 motor outputs</small></dd></div>
        </dl>
      </div>

      <div class="errata">
        <figure class="plate plate-fc" data-ascii={fcPlate.ascii}>
          <Picture src={flightController} alt="LithCore flight controller, populated board" widths={[640, 960, 1400]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
          <canvas aria-hidden="true"></canvas>
          <figcaption class="mono"><span>{fcPlate.n}</span>{fcPlate.title}</figcaption>
        </figure>
        <div class="errata-list">
          <h3 class="mono">Rev A — bring-up</h3>
          <ol class="mono">
            <li><span>E1</span>VDDA left unconnected from 3V3. Bridged across two decoupling capacitors.</li>
            <li><span>E2</span>BOOT0 button footprint open. DFU forced with a solder bridge.</li>
            <li><span>E3</span>IMU sourced as clone parts. Driver rewritten against the actual register map.</li>
          </ol>
          <p class="note">Board runs firmware over USB and SWD. Both layout errata are closed for Rev B.</p>
        </div>
      </div>
    </section>

    <!-- 03 — ESC -->
    <section id="lithdrive" class="chapter" data-section="lithdrive">
      <header class="chapter-head">
        <span class="chapter-n mono">03</span>
        <h2><span class="chapter-kicker mono">Motor drive</span>LithDrive 6S</h2>
        <p class="chapter-lede">
          Sensorless three-phase drive. Back-EMF zero-crossing against a virtual neutral, rebuilt for a 6S bus.
        </p>
      </header>

      <div class="board board-wide" data-svg="/data/aerolith/lithdrive.svg" data-meta="/data/aerolith/lithdrive.json" data-cycle="MOTORA,MOTORB,MOTORC,BEMF_COMMON,GHA,VBAT,SIGNAL_INPUT,10V">
        <div class="board-view">
          <div class="board-tools mono">
            <div class="layers" role="group" aria-label="Copper layer">
              <button data-view="all" aria-pressed="true">All</button>
              <button data-view="top" aria-pressed="false">Top</button>
              <button data-view="in1" aria-pressed="false">In1</button>
              <button data-view="in2" aria-pressed="false">In2</button>
              <button data-view="bot" aria-pressed="false">Bot</button>
            </div>
            <div class="readout" aria-live="polite"><span>Net</span><b data-out="net">—</b><em data-out="info"></em></div>
          </div>
          <div class="pcb-stage"><canvas aria-label="LithDrive 6S copper layout rendered as text, hover to trace a net"></canvas></div>
          <p class="board-dim mono"><span>{esc.w} × {esc.h} mm</span><span>4 layers</span><span>{esc.components} parts</span><span>{esc.vias} vias</span></p>
        </div>
        <dl class="spec spec-row mono">
          <div><dt>MCU</dt><dd>STM32F051C8T6<small>AM32-compatible</small></dd></div>
          <div><dt>Gate drive</dt><dd>DRV8300<small>Bootstrap high side</small></dd></div>
          <div><dt>Bridge</dt><dd>6 × XRS200N06HF<small>N-channel MOSFET</small></dd></div>
          <div><dt>Supply</dt><dd>LM5164 buck, AMS1117<small>VBAT → 10 V → 3V3</small></dd></div>
          <div><dt>Sensing</dt><dd>BEMF A / B / C<small>Divider + common node</small></dd></div>
        </dl>
      </div>

      <div class="lineage">
        <div class="lineage-text">
          <h3 class="mono">Lineage</h3>
          <p>
            Derived from the 2S LithDrive built for Nanolith. Its bring-up found three faults (a duplicated BEMF net
            label, a missing junction on the common node and one dry joint), all patched under the microscope. After
            the fix, the motor ran without cogging.
          </p>
          <p class="note">6S revision: larger MOSFETs, reworked dividers, gate drive and bootstrap for the higher bus voltage.</p>
        </div>
        <figure class="plate plate-windings" data-ascii={windingsPlate.ascii}>
          <Picture src={windings} alt="Motor stator with copper windings" widths={[640, 960, 1400]} sizes="(min-width: 900px) 42vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
          <canvas aria-hidden="true"></canvas>
          <figcaption class="mono"><span>{windingsPlate.n}</span>{windingsPlate.title}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 04 — Statut -->
    <section id="status" class="chapter" data-section="status">
      <header class="chapter-head">
        <span class="chapter-n mono">04</span>
        <h2><span class="chapter-kicker mono">Program</span>Status</h2>
        <p class="chapter-lede">Where each subsystem stands, from the build logs.</p>
      </header>
      <div class="matrix mono" role="table" aria-label="Subsystem status">
        <div class="m-row m-head" role="row">
          <span role="columnheader">System</span>
          {stages.map((s) => <span role="columnheader" class="m-stage">{s}</span>)}
          <span role="columnheader" class="m-note">Note</span>
        </div>
        {status.map((r) => (
          <div class:list={['m-row', { 'm-group': r.group }]} role="row">
            <span role="cell" class="m-name"><i>{r.group}</i>{r.name}</span>
            {r.s.map((v, k) => (
              <span role="cell" class:list={['m-cell', `v${v}`]} aria-label={`${stages[k]}: ${['not started', 'in progress', 'done'][v]}`}>{glyph[v]}</span>
            ))}
            <span role="cell" class="m-note">{r.note}</span>
          </div>
        ))}
      </div>
      <p class="legend mono"><span><b class="v2">■</b> Done</span><span><b class="v1">■</b> In progress</span><span><b class="v0">·</b> Not started</span></p>
    </section>

    <!-- Planches -->
    <section class="plates" aria-label="Renders">
      <header class="plates-head mono"><span>Plates</span><span>Cycles renders of the F380 assembly</span></header>
      <div class="plates-grid">
        {plates.map((p) => (
          <figure class:list={['plate', `plate-${p.span}`]} data-ascii={p.ascii}>
            <Picture src={p.image} alt={`Aerolith, ${p.title.toLowerCase()}`} widths={[640, 960, 1400, 1920]} sizes="(min-width: 900px) 66vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" quality={50} loading="lazy" />
            <canvas aria-hidden="true"></canvas>
            <figcaption class="mono"><span>{p.n}</span>{p.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>

  <footer class="foot">
    <p class="foot-line">Open hardware. Schematics, layouts and firmware are released at first flight.</p>
    <div class="foot-cols mono">
      <div>
        <h3>Build logs</h3>
        <a href="/posts/2026-04-11-aerolith">Aerolith, status update</a>
        <a href="/posts/2026-05-01-fc">LithCore flight controller</a>
        <a href="/posts/2026-02-15-bldc-esc">LithDrive sensorless ESC</a>
      </div>
      <div>
        <h3>Portfolio</h3>
        <a href="/archive">Posts</a>
        <a href="/about">About</a>
        <a href="/resume">Resume</a>
      </div>
      <div class="foot-sign">
        <svg viewBox="-7.5 -7 15 14" aria-hidden="true"><path d={mark} /></svg>
        <span>© {new Date().getFullYear()} Robin Marin-Muller</span>
      </div>
    </div>
  </footer>

  <script>
    import { initHero } from '../scripts/aerolith/hero';
    import { initCutsheet } from '../scripts/aerolith/cutsheet';
    import { initPcb } from '../scripts/aerolith/pcb';
    import { initPlates, initDecode } from '../scripts/aerolith/plates';
    import { whenNear } from '../scripts/aerolith/glyphs';

    const hero = document.querySelector<HTMLElement>('.hero')!;
    initHero(hero).catch(() => hero.classList.remove('is-live'));
    const cut = document.querySelector<HTMLElement>('.cutsheet')!;
    whenNear(cut, () => initCutsheet(cut));
    document.querySelectorAll<HTMLElement>('.board').forEach((b) => initPcb(b));
    initPlates();
    initDecode();

    // Barre : section courante et progression de lecture.
    const now = document.querySelector<HTMLElement>('.bar-now')!;
    const links = new Map([...document.querySelectorAll<HTMLElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const a = links.get((e.target as HTMLElement).dataset.section!);
          if (!a) continue;
          a.classList.toggle('is-current', e.isIntersecting);
          if (e.isIntersecting) now.innerHTML = a.innerHTML;
          else if (now.innerHTML === a.innerHTML) now.innerHTML = '';
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('[data-section]').forEach((s) => io.observe(s));
    const bar = document.querySelector<HTMLElement>('.bar')!;
    const prog = document.querySelector<HTMLElement>('.bar-progress')!;
    let raf = 0;
    const onScroll = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      prog.style.transform = `scaleX(${scrollY / Math.max(max, 1)})`;
      bar.classList.toggle('is-solid', scrollY > innerHeight * 0.6);
    };
    addEventListener('scroll', () => raf || (raf = requestAnimationFrame(onScroll)), { passive: true });
    onScroll();
  </script>
</Aerolith>

<style>
  .mono {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ───── Barre ───── */
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--bar);
    padding: 0 var(--m);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }

  .bar.is-solid {
    background: rgba(6, 6, 6, 0.94);
    border-bottom-color: var(--line);
  }

  .bar a {
    text-decoration: none;
  }

  .bar-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .bar-mark svg {
    width: 15px;
    height: 14px;
    fill: var(--ink);
    transform: rotate(0deg);
  }

  .bar-nav {
    display: flex;
    gap: clamp(16px, 2.6vw, 40px);
  }

  .bar-nav a {
    color: var(--ink-3);
    transition: color 0.25s;
  }

  .bar-nav a i {
    font-style: normal;
    margin-right: 6px;
    color: var(--ink-4);
  }

  .bar-nav a:hover,
  .bar-nav a.is-current {
    color: var(--ink);
  }

  .bar-nav a.is-current i {
    color: var(--sig);
  }

  .bar-out {
    justify-self: end;
    color: var(--ink-2);
  }

  .bar-out:hover {
    color: var(--ink);
  }

  .bar-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--sig);
    transform-origin: left;
    transform: scaleX(0);
  }

  .bar-now {
    display: none;
  }

  @media (max-width: 760px) {
    .bar-nav {
      display: none;
    }

    .bar-now {
      display: block;
      color: var(--ink);
    }

    .bar-now :global(i) {
      font-style: normal;
      margin-right: 6px;
      color: var(--sig);
    }
  }

  /* ───── Hero ───── */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--bg);
    cursor: crosshair;
  }

  .hero :global(.hero-fallback),
  .hero :global(.hero-fallback img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-ascii {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .hero:global(.is-live) .hero-ascii {
    opacity: 1;
  }

  .hero-ui {
    position: absolute;
    inset: auto 0 0;
    padding: 0 var(--m) calc(var(--m) * 0.9);
    pointer-events: none;
    background: linear-gradient(to top, rgba(6, 6, 6, 0.85), rgba(6, 6, 6, 0) 100%);
  }

  .hero-fig {
    margin: 0 0 12px;
    color: var(--ink-3);
  }

  .wordmark {
    margin: 0 0 clamp(18px, 2.4vw, 32px) -0.06em;
    font-family: var(--mono);
    font-weight: 400;
    font-weight: 300;
    font-size: clamp(54px, 10.2vw, 184px);
    line-height: 0.8;
    letter-spacing: -0.075em;
    color: var(--ink);
    white-space: nowrap;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap);
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .hero-meta div {
    display: grid;
    gap: 2px;
  }

  .hero-meta dt {
    color: var(--ink-3);
  }

  .hero-meta dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pulse {
    width: 6px;
    height: 6px;
    background: var(--sig);
    animation: pulse 1.6s steps(2, jump-none) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.2;
    }
  }

  @media (max-width: 760px) {
    .hero-meta {
      grid-template-columns: 1fr 1fr;
      row-gap: 14px;
    }

    .hero-ui {
      padding-top: 120px;
      background: linear-gradient(to top, rgba(6, 6, 6, 0.96) 55%, rgba(6, 6, 6, 0) 100%);
    }

    .wordmark {
      font-size: calc((100vw - 2 * var(--m)) / 4.12);
    }


  }

  /* ───── Thèse ───── */
  .thesis {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(96px, 16vw, 220px) var(--m) clamp(72px, 10vw, 140px);
  }

  .thesis-line {
    grid-column: 1 / span 10;
    margin: 0;
    font-size: clamp(30px, 4.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 300;
    text-wrap: balance;
  }

  .thesis-line em {
    font-style: normal;
    color: var(--sig);
  }

  .thesis-aside {
    grid-column: 1 / span 4;
    margin-top: clamp(32px, 5vw, 64px);
    color: var(--ink-3);
  }

  .thesis-aside p {
    margin: 0 0 4px;
  }

  .stack {
    grid-column: 6 / span 7;
    margin: clamp(32px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .stack a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.2s, padding 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  .stack i {
    font-style: normal;
    color: var(--ink-4);
  }

  .stack em {
    font-style: normal;
    color: var(--ink-3);
  }

  .stack a:hover {
    padding-left: 10px;
  }

  .stack a:hover i {
    color: var(--sig);
  }

  @media (max-width: 760px) {
    .thesis {
      grid-template-columns: 1fr;
    }

    .thesis > * {
      grid-column: 1 !important;
    }

    .stack a {
      grid-template-columns: 36px 1fr auto;
    }
  }

  /* ───── Chapitres ───── */
  .chapter {
    position: relative;
    padding: clamp(80px, 11vw, 160px) var(--m) 0;
    border-top: 1px solid var(--line);
  }

  .chapter-head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 88px);
  }

  .chapter-n {
    grid-column: 1 / span 2;
    align-self: start;
    color: var(--sig);
  }

  .chapter-head h2 {
    grid-column: 3 / span 6;
    margin: 0;
    font-weight: 300;
    font-size: clamp(44px, 7.4vw, 124px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .chapter-kicker {
    display: block;
    margin-bottom: 18px;
    color: var(--ink-3);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .chapter-lede {
    grid-column: 9 / span 4;
    margin: 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.45;
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .chapter-head {
      grid-template-columns: 1fr;
    }

    .chapter-head > * {
      grid-column: 1 !important;
    }

    .chapter-lede {
      margin-top: 12px;
    }
  }

  .note {
    color: var(--ink-3);
    font-size: 14px;
    line-height: 1.5;
    max-width: 44ch;
  }

  /* ───── Plaque de découpe ───── */
  .cutsheet {
    height: 260vh;
    margin: 0 calc(var(--m) * -1);
  }

  .cut-sticky {
    position: sticky;
    top: var(--bar);
    height: calc(100vh - var(--bar));
    height: calc(100svh - var(--bar));
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 14px;
    padding: 18px var(--m) 22px;
  }

  .cut-head {
    display: flex;
    justify-content: space-between;
    color: var(--ink-3);
  }

  .cut-hint {
    color: var(--ink-4);
  }

  .cut-stage {
    position: relative;
    align-self: center;
    width: min(100%, calc((100svh - var(--bar) - 140px) * var(--sheet-ar, 1.75)));
    justify-self: center;
  }

  .cut-stage canvas {
    width: 100%;
  }

  .cut-stage :global(.cut-layer) {
    position: absolute;
    top: 0;
    left: 0;
  }

  .tick {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--ink-3);
  }

  .tl { top: -8px; left: -8px; border-top-width: 1px; border-left-width: 1px; }
  .tr { top: -8px; right: -8px; border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: -8px; left: -8px; border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: -8px; right: -8px; border-bottom-width: 1px; border-right-width: 1px; }

  .cut-read {
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    gap: 6px clamp(20px, 4vw, 56px);
    align-items: center;
  }

  .cut-read div {
    display: flex;
    gap: 10px;
    white-space: nowrap;
  }

  .cut-read span {
    color: var(--ink-3);
  }

  .cut-read b {
    font-weight: 400;
  }

  .cut-read output {
    color: var(--ink);
  }

  .cut-bar {
    height: 1px;
    background: var(--line);
  }

  .cut-bar i {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--sig);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 640px) {
    .cutsheet {
      height: 300vh;
    }

    .cut-stage {
      width: min(100%, calc((100svh - var(--bar) - 170px) * var(--sheet-ar, 0.57)));
    }

    .cut-read {
      grid-template-columns: 1fr 1fr;
    }

    .cut-read div:nth-child(3) {
      grid-column: 1 / -1;
      order: -1;
    }

    .cut-bar {
      grid-column: 1 / -1;
    }

    .cut-hint {
      display: none;
    }
  }

  .frame-detail {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(48px, 7vw, 100px) 0 clamp(80px, 11vw, 160px);
    align-items: start;
  }

  .parts {
    grid-column: 1 / span 5;
    width: 100%;
    border-collapse: collapse;
  }

  .parts caption {
    text-align: left;
    color: var(--ink-3);
    padding-bottom: 14px;
  }

  .parts th {
    text-align: left;
    font-weight: 400;
    color: var(--ink-3);
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .parts td {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .parts td:not(:first-child),
  .parts th:not(:first-child) {
    text-align: right;
  }

  .frame-detail > .note {
    grid-column: 1 / span 4;
    grid-row: 2;
    margin: 28px 0 0;
  }

  .plate-exploded {
    grid-column: 6 / span 7;
    grid-row: 1 / span 2;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 900px) {
    .frame-detail {
      grid-template-columns: 1fr;
    }

    .frame-detail > * {
      grid-column: 1 !important;
      grid-row: auto !important;
    }

    .plate-exploded {
      margin: 24px calc(var(--m) * -1) 0;
      aspect-ratio: 3 / 4;
    }
  }

  /* ───── Planches ───── */
  .plate {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--bg);
  }

  .plate :global(picture),
  .plate :global(img),
  .plate canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .plate :global(img) {
    object-fit: cover;
  }

  .plate canvas {
    opacity: 0;
    pointer-events: none;
  }

  .plate:global(.is-ascii) canvas {
    opacity: 1;
  }

  .plate:global(.is-ascii) :global(img) {
    opacity: 0;
  }

  .plate:global(.is-developed) :global(img) {
    opacity: 1;
    transition: opacity 0.01s 0.05s;
  }

  .plate:global(.is-developed) canvas {
    -webkit-mask-image: linear-gradient(to bottom, transparent 40%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 40%, #000 60%);
    -webkit-mask-size: 100% 250%;
    mask-size: 100% 250%;
    -webkit-mask-position: 0 100%;
    mask-position: 0 100%;
    animation: develop 1.5s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }

  @keyframes develop {
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      opacity: 1;
      visibility: hidden;
    }
  }

  .plate figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    display: flex;
    gap: 14px;
    color: var(--ink-2);
    z-index: 1;
  }

  .plate figcaption span {
    color: var(--ink-4);
  }

  /* ───── Cartes électroniques ───── */
  .board {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    align-items: start;
  }

  .board-view {
    min-width: 0;
  }

  .board-square .board-view {
    grid-column: 1 / span 7;
  }

  .board-square .spec {
    grid-column: 9 / span 4;
    align-self: center;
  }

  .board-wide .board-view,
  .board-wide .spec {
    grid-column: 1 / -1;
  }

  .board-tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .layers {
    display: flex;
    border: 1px solid var(--line);
  }

  .layers button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink-3);
    background: none;
    border: 0;
    border-right: 1px solid var(--line);
    padding: 7px 11px;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }

  .layers button:last-child {
    border-right: 0;
  }

  .layers button:hover {
    color: var(--ink);
  }

  .layers button[aria-pressed='true'] {
    color: #000;
    background: var(--ink);
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .readout span {
    color: var(--ink-3);
  }

  .readout b {
    font-weight: 400;
    color: var(--sig);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .readout em {
    font-style: normal;
    color: var(--ink-3);
  }

  .pcb-stage {
    position: relative;
    min-height: 120px;
  }

  .board-square .pcb-stage {
    max-width: calc(100svh - var(--bar) - 190px);
  }

  @media (max-width: 900px) {
    .board-square .pcb-stage {
      max-width: none;
    }
  }

  .pcb-stage canvas {
    width: 100%;
    cursor: crosshair;
    touch-action: manipulation;
  }

  .pcb-stage :global(.pcb-overlay) {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .board-dim {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 18px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
  }

  .spec {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .spec div {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .spec dt {
    color: var(--ink-3);
  }

  .spec dd {
    margin: 0;
  }

  .spec small {
    display: block;
    font-size: inherit;
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .spec-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0 var(--gap);
    margin-top: clamp(32px, 4vw, 56px);
  }

  .spec-row div {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  @media (max-width: 900px) {
    .board {
      grid-template-columns: 1fr;
    }

    .board > * {
      grid-column: 1 !important;
    }

    .board-square .spec {
      margin-top: 32px;
    }

    .spec-row {
      grid-template-columns: 1fr;
    }

    .spec-row div {
      grid-template-columns: 76px 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .board-tools {
      flex-direction: column;
      align-items: stretch;
    }

    .layers button {
      flex: 1;
    }

    .board-wide .pcb-stage {
      margin: 0 calc(var(--m) * -0.5);
    }
  }

  .errata,
  .lineage {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding: clamp(64px, 9vw, 128px) 0 clamp(80px, 11vw, 160px);
    align-items: end;
  }

  .plate-fc {
    grid-column: 1 / span 7;
    aspect-ratio: 16 / 10;
  }

  .errata-list {
    grid-column: 9 / span 4;
  }

  .errata-list h3,
  .lineage-text h3 {
    margin: 0 0 16px;
    font-weight: 400;
    color: var(--ink-3);
  }

  .errata-list ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .errata-list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .errata-list li span {
    color: var(--sig);
  }

  .lineage-text {
    grid-column: 1 / span 5;
  }

  .lineage-text p {
    margin: 0 0 16px;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .plate-windings {
    grid-column: 7 / span 6;
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 900px) {
    .errata,
    .lineage {
      grid-template-columns: 1fr;
    }

    .errata > *,
    .lineage > * {
      grid-column: 1 !important;
    }

    .plate-fc,
    .plate-windings {
      margin: 0 calc(var(--m) * -1);
      aspect-ratio: 4 / 5;
    }

    .lineage .plate-windings {
      order: -1;
      margin-bottom: 32px;
    }

    .errata-list {
      margin-top: 32px;
    }
  }

  /* ───── Statut ───── */
  .matrix {
    border-top: 1px solid var(--line);
  }

  .m-row {
    display: grid;
    grid-template-columns: minmax(180px, 3fr) repeat(4, minmax(48px, 1fr)) minmax(160px, 3fr);
    gap: var(--gap);
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .m-group {
    border-top: 1px solid var(--ink-4);
  }

  .m-head {
    color: var(--ink-3);
  }

  .m-name {
    display: grid;
    grid-template-columns: 96px 1fr;
    white-space: nowrap;
  }

  .m-name i {
    font-style: normal;
    color: var(--ink-3);
    grid-column: 1;
  }

  .m-head span:first-child {
    padding-left: 96px;
  }

  .m-stage,
  .m-cell {
    text-align: center;
  }

  .m-cell {
    font-size: 14px;
    line-height: 1;
  }

  .v2 {
    color: var(--ink);
  }

  .v1 {
    color: var(--sig);
    font-size: 14px;
    animation: pulse 1.6s steps(2, jump-none) infinite;
  }

  .v0 {
    color: var(--ink-4);
  }

  .m-row:not(.m-head) .m-note {
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .legend {
    display: flex;
    gap: 28px;
    margin: 20px 0 clamp(96px, 13vw, 180px);
    color: var(--ink-3);
  }

  .legend b {
    font-weight: 400;
    margin-right: 8px;
  }

  @media (max-width: 760px) {
    .m-head {
      display: none;
    }

    .m-row {
      grid-template-columns: 1fr repeat(4, 14px);
      gap: 6px 12px;
      align-items: center;
    }

    .m-row > * {
      grid-row: 1;
    }

    .m-row > :nth-child(2) { grid-column: 2; }
    .m-row > :nth-child(3) { grid-column: 3; }
    .m-row > :nth-child(4) { grid-column: 4; }
    .m-row > :nth-child(5) { grid-column: 5; }

    .m-name {
      grid-column: 1;
      grid-template-columns: 1fr;
      white-space: normal;
    }

    .m-name i:not(:empty) {
      margin-bottom: 6px;
    }

    .m-row > .m-note {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* ───── Grille de planches ───── */
  .plates {
    padding: clamp(80px, 11vw, 160px) var(--m);
    border-top: 1px solid var(--line);
  }

  .plates-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
    color: var(--ink-3);
  }

  .plates-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }

  .plate-a { grid-column: 1 / span 8; aspect-ratio: 16 / 10; }
  .plate-b { grid-column: 9 / span 4; }
  .plate-c { grid-column: 1 / span 5; aspect-ratio: 4 / 5; }
  .plate-d { grid-column: 6 / span 7; }
  .plate-e { grid-column: 1 / -1; aspect-ratio: 21 / 9; }

  @media (max-width: 900px) {
    .plates {
      padding-left: 0;
      padding-right: 0;
    }

    .plates-head {
      padding: 0 var(--m);
    }

    .plates-grid {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .plates-grid .plate {
      grid-column: 1;
      aspect-ratio: 4 / 5;
    }

    .plates-grid .plate-e {
      aspect-ratio: 1 / 1;
    }
  }

  /* ───── Pied ───── */
  .foot {
    padding: clamp(80px, 11vw, 160px) var(--m) var(--m);
    border-top: 1px solid var(--line);
  }

  .foot-line {
    margin: 0 0 clamp(64px, 9vw, 120px);
    max-width: 18ch;
    font-size: clamp(30px, 4.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .foot-cols div {
    grid-column: span 4;
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .foot-cols h3 {
    margin: 0 0 8px;
    font-weight: 400;
    font-size: inherit;
    color: var(--ink-3);
  }

  .foot-cols a {
    text-decoration: none;
    color: var(--ink-2);
    width: fit-content;
  }

  .foot-cols a:hover {
    color: var(--sig);
  }

  .foot-sign {
    justify-items: end;
    color: var(--ink-3);
  }

  .foot-sign svg {
    width: 22px;
    height: 20px;
    fill: var(--ink);
    margin-bottom: 8px;
